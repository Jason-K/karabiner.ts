{
  "name": "karabiner-config",
  "version": "0.0.0",
  "description": "Personal Karabiner-Elements configuration, compiled from TypeScript",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx src/index.ts && hs -c \"hs.reload()\"",
    "generate": "tsx src/index.ts",
    "explain": "tsx src/explain.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test 'src/**/*.test.ts'",
    "check": "npm run typecheck && npm run lint && npm run test",
    "lint": "eslint src --max-warnings=81"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20",
    "eslint": "^9.39.1",
    "tsx": "^4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0"
  }
}
